# Copy to .env (which git ignores) and fill in. Never commit a real key.

# Leave empty to run the recorded demo, which needs no model.
OPENROUTER_API_KEY=

# auto: live when a key is set, recorded otherwise. Or force "live" / "replay".
CLAIMCHECK_MODE=auto

# The answer model must return token log-probabilities. The rates shown beside
# the threshold were measured with gpt-4o-mini; after changing the model, run
# the evaluation again (docs/evaluation.md). qwen/qwen3-next-80b-a3b-instruct
# also ran the whole pipeline in a two-question check.
CLAIMCHECK_MODEL=openai/gpt-4o-mini
CLAIMCHECK_JUDGE_MODEL=openai/gpt-4o-mini

# Any OpenAI-compatible endpoint works, for example a local Ollama server:
# CLAIMCHECK_API_BASE=http://localhost:11434/v1

# Limits for a public demo that spends from one key.
CLAIMCHECK_RATE_LIMIT_PER_CLIENT=8
CLAIMCHECK_RATE_LIMIT_WINDOW_SECONDS=600
CLAIMCHECK_DAILY_REQUEST_CAP=400
CLAIMCHECK_TRUST_PROXY_HEADERS=false
